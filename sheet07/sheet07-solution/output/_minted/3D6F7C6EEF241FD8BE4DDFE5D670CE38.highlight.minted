        \PYG{k}{return} \PYG{k+kc}{False}


\PYG{c+c1}{\PYGZsh{} TODO: generate a list of 1000 random points in a square of side length 2.0 using generate\PYGZus{}random\PYGZus{}point\PYGZus{}in\PYGZus{}square and list comprehension}
\PYG{n}{N} \PYG{o}{=} \PYG{l+m+mi}{1000}
