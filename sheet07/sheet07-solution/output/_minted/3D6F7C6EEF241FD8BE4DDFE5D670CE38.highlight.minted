\PYG{n}{x\PYGZus{}values\PYGZus{}full} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{(}\PYG{n}{full\PYGZus{}list\PYGZus{}of\PYGZus{}points}\PYG{p}{)}\PYG{p}{[}\PYG{p}{:}\PYG{p}{,} \PYG{l+m+mi}{0}\PYG{p}{]}
