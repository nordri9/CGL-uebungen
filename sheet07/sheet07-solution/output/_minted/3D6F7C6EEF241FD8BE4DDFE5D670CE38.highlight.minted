    \PYG{n}{d} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{linalg}\PYG{o}{.}\PYG{n}{norm}\PYG{p}{(}\PYG{n}{b}\PYG{o}{\PYGZhy{}}\PYG{n}{a}\PYG{p}{)}
    \PYG{k}{return} \PYG{n}{d}


\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{point\PYGZus{}in\PYGZus{}circle}\PYG{p}{(}\PYG{n}{p}\PYG{p}{,} \PYG{n}{center}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{,} \PYG{n}{radius}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{)}\PYG{p}{:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
