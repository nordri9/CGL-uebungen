\PYG{c+c1}{\PYGZsh{} TODO: print the ratio of the number of points in filtered\PYGZus{}list\PYGZus{}of\PYGZus{}points to the total number of generated points}
\PYG{n}{N\PYGZus{}filtered} \PYG{o}{=} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{filtered\PYGZus{}list\PYGZus{}of\PYGZus{}points}\PYG{p}{)}
