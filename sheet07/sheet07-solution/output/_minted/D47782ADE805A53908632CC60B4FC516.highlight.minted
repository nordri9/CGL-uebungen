\PYG{k+kn}{import}\PYG{+w}{ }\PYG{n+nn}{matplotlib}\PYG{n+nn}{.}\PYG{n+nn}{pyplot}\PYG{+w}{ }\PYG{k}{as}\PYG{+w}{ }\PYG{n+nn}{plt}

\PYG{n}{dateiname} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{messdaten.txt}\PYG{l+s+s2}{\PYGZdq{}}
\PYG{n}{x\PYGZus{}werte} \PYG{o}{=} \PYG{p}{[}\PYG{p}{]}
\PYG{n}{y\PYGZus{}werte} \PYG{o}{=} \PYG{p}{[}\PYG{p}{]}

\PYG{c+c1}{\PYGZsh{} 1. Datei öffnen und Schleife über Zeilen}
\PYG{k}{with} \PYG{n+nb}{open}\PYG{p}{(}\PYG{n}{dateiname}\PYG{p}{,} \PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{r}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)} \PYG{k}{as} \PYG{n}{datei}\PYG{p}{:}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{Verarbeite Daten aus }\PYG{l+s+s2}{\PYGZsq{}}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{dateiname}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZsq{}}\PYG{l+s+s2}{...}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}
    
    \PYG{k}{for} \PYG{n}{zeilennummer}\PYG{p}{,} \PYG{n}{zeile} \PYG{o+ow}{in} \PYG{n+nb}{enumerate}\PYG{p}{(}\PYG{n}{datei}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{)}\PYG{p}{:}
        
        \PYG{c+c1}{\PYGZsh{} 2. .strip() verwenden}
        \PYG{n}{bereinigte\PYGZus{}zeile} \PYG{o}{=} \PYG{n}{zeile}\PYG{o}{.}\PYG{n}{strip}\PYG{p}{(}\PYG{p}{)}
        
        \PYG{c+c1}{\PYGZsh{} 3. Filtern von leeren Zeilen und Kommentaren}
        \PYG{k}{if} \PYG{o+ow}{not} \PYG{n}{bereinigte\PYGZus{}zeile} \PYG{o+ow}{or} \PYG{n}{bereinigte\PYGZus{}zeile}\PYG{o}{.}\PYG{n}{startswith}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{\PYGZsh{}}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}\PYG{p}{:}
            \PYG{c+c1}{\PYGZsh{} Ignoriere auch Zeilen, die mit \PYGZsq{}\PYGZsh{}\PYGZsq{} (Kommentar) beginnen}
            \PYG{k}{continue}
        
        \PYG{c+c1}{\PYGZsh{} 4. Sonst Zeile ausgeben und Werte extrahieren}
        \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{Verarbeite: }\PYG{l+s+s2}{\PYGZsq{}}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{bereinigte\PYGZus{}zeile}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZsq{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{}Teile die bereinigte\PYGZus{}zeile in Einzelteile auf}
        \PYG{n}{teile} \PYG{o}{=} \PYG{n}{bereinigte\PYGZus{}zeile}\PYG{o}{.}\PYG{n}{split}\PYG{p}{(}\PYG{p}{)}

        \PYG{k}{if} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{teile}\PYG{p}{)} \PYG{o}{==} \PYG{l+m+mi}{2}\PYG{p}{:}
            \PYG{c+c1}{\PYGZsh{} Wandel die Teile in Gleitkommazahlen um}
            \PYG{n}{x} \PYG{o}{=} \PYG{n+nb}{float}\PYG{p}{(}\PYG{n}{teile}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{p}{)}
            \PYG{n}{y} \PYG{o}{=} \PYG{n+nb}{float}\PYG{p}{(}\PYG{n}{teile}\PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{]}\PYG{p}{)}
            
            \PYG{c+c1}{\PYGZsh{} Speicher die Werte in den Listen x\PYGZus{}werte und y\PYGZus{}werte}
            \PYG{n}{x\PYGZus{}werte}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{x}\PYG{p}{)}
            \PYG{n}{y\PYGZus{}werte}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{y}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} 5. Am Ende alle Tupel x\PYGZhy{}y plotten}
\PYG{k}{if} \PYG{n}{x\PYGZus{}werte}\PYG{p}{:}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{Erfolgreich }\PYG{l+s+si}{\PYGZob{}}\PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{x\PYGZus{}werte}\PYG{p}{)}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{ Datenpunkte gesammelt. Erstelle Plot.}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}
    
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{figure}\PYG{p}{(}\PYG{p}{)}
    \PYG{c+c1}{\PYGZsh{} Verwende Sie plt.scatter() um x\PYGZus{}werte gegen y\PYGZus{}werte zu plotten}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{scatter}\PYG{p}{(}\PYG{n}{x\PYGZus{}werte}\PYG{p}{,}\PYG{n}{y\PYGZus{}werte}\PYG{p}{)}
        
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{title}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{Messdaten aus Datei}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{xlabel}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{X\PYGZhy{}Koordinate}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{ylabel}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{Y\PYGZhy{}Koordinate}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{grid}\PYG{p}{(}\PYG{k+kc}{True}\PYG{p}{)}
    \PYG{c+c1}{\PYGZsh{} plt.savefig(\PYGZsq{}messdaten\PYGZus{}plot.pdf\PYGZsq{})}
    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{savefig}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{messdaten\PYGZus{}plot.png}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}

    \PYG{n}{plt}\PYG{o}{.}\PYG{n}{show}\PYG{p}{(}\PYG{p}{)}
\PYG{k}{else}\PYG{p}{:}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{Keine gültigen Daten zum Plotten gefunden.}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}
    
    
